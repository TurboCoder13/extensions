{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "renaming",
  "title": "Renaming",
  "description": "A powerful batch file renaming tool with regex support, case transformation, undo history, and presets.",
  "version": "2.0.0",
  "keywords": [
    "rename",
    "finder",
    "file",
    "folder",
    "batch",
    "regex",
    "case",
    "undo",
    "productivity",
    "utility"
  ],
  "icon": "renaming-icon.png",
  "author": "theo_daguier",
  "contributors": [
    "pernielsentikaer",
    "ridemountainpig",
    "TurboCoder13"
  ],
  "categories": [
    "Productivity",
    "Media",
    "System"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "index",
      "title": "Rename File(s)",
      "description": "Batch rename files with prefix, suffix, numbering, and case transformation.",
      "mode": "view"
    },
    {
      "name": "replace",
      "title": "Replace File(s) Characters",
      "description": "Find and replace characters in filenames with optional regex.",
      "mode": "view"
    },
    {
      "name": "history",
      "title": "Rename History",
      "description": "View and undo recent rename operations.",
      "mode": "view"
    },
    {
      "name": "presets",
      "title": "Rename Presets",
      "description": "Manage saved rename configurations.",
      "mode": "view"
    },
    {
      "name": "clipboard-rename",
      "title": "Clipboard Rename",
      "description": "Rename files using names from clipboard.",
      "mode": "view"
    },
    {
      "name": "ai-suggest",
      "title": "AI Smart Rename",
      "description": "Generate descriptive names using AI.",
      "mode": "view"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.65.1",
    "@raycast/utils": "^1.12.5",
    "exifreader": "^4.36.1",
    "safe-regex": "^2.1.1"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "20.8.10",
    "@types/react": "18.2.27",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.51.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.0.3",
    "typescript": "^5.2.2",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "platforms": [
    "macOS"
  ]
}
